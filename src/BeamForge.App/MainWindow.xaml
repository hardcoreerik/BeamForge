<Window x:Class="BeamForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeamForge" Width="1280" Height="820" MinWidth="1000" MinHeight="680"
        Background="#0F172A" Foreground="#E2E8F0"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#475569"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="4"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="5"/></Style>
        <Style TargetType="TabItem"><Setter Property="Padding" Value="16,8"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#450A0A" BorderBrush="#DC2626" BorderThickness="0,0,0,2" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="Bold" Text="SIMULATOR ONLY - LIVE LASER OUTPUT IS BLOCKED"/>
                    <TextBlock Foreground="#FCA5A5" Text="Escape issues blackout. Software is not a safety system; keep a physical power cutoff accessible."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionStateText" Margin="8" VerticalAlignment="Center" FontWeight="Bold" Text="Disconnected"/>
                    <Button x:Name="ConnectButton" Click="Connect_Click" Content="Connect simulator"/>
                    <Button x:Name="ArmButton" Click="Arm_Click" Content="ARM" Background="#B45309"/>
                    <Button Click="Blackout_Click" Content="BLACKOUT" Background="#B91C1C" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="8" Background="#111827" Foreground="#111827">
            <TabItem Header="Live Control">
                <Grid Background="#111827">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox Header="Audio input">
                                <StackPanel>
                                    <ComboBox x:Name="AudioSourceCombo" SelectionChanged="AudioSource_Changed"/>
                                    <ComboBox x:Name="AudioDeviceCombo" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="StartAudio_Click" Content="Start audio"/>
                                        <Button Click="StopAudio_Click" Content="Stop + blackout"/>
                                        <CheckBox x:Name="AutoModeCheck" Content="Automatic mode" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Margin="3" Text="Energy"/>
                                    <ProgressBar x:Name="EnergyMeter" Height="12" Maximum="100"/>
                                    <UniformGrid Columns="3" Margin="0,6,0,0">
                                        <StackPanel><TextBlock Text="Low"/><ProgressBar x:Name="LowMeter" Height="10" Maximum="100"/></StackPanel>
                                        <StackPanel Margin="4,0"><TextBlock Text="Mid"/><ProgressBar x:Name="MidMeter" Height="10" Maximum="100"/></StackPanel>
                                        <StackPanel><TextBlock Text="High"/><ProgressBar x:Name="HighMeter" Height="10" Maximum="100"/></StackPanel>
                                    </UniformGrid>
                                    <TextBlock x:Name="BeatText" Margin="3" Text="Beat: -"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Scenes">
                                <StackPanel>
                                    <TextBox x:Name="SceneNameText" Text="Scene 1"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="SaveScene_Click" Content="Capture scene"/>
                                        <Button Click="ApplyScene_Click" Content="Apply selected"/>
                                    </StackPanel>
                                    <ListBox x:Name="ScenesList" DisplayMemberPath="Name" Height="130"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Safety limits">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Start address"/><TextBox x:Name="StartAddressText" Grid.Row="0" Grid.Column="1" Text="1"/>
                                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Intensity ceiling %"/><TextBox x:Name="IntensityCeilingText" Grid.Row="1" Grid.Column="1" Text="25"/>
                                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Silence timeout s"/><TextBox x:Name="SilenceTimeoutText" Grid.Row="2" Grid.Column="1" Text="3"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                    <GroupBox Grid.Column="1" Header="Full mixer">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Margin="5" Foreground="#94A3B8" Text="All values pass through the shared safety controller. Hazardous channels stay locked."/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="MixerItems" ItemsSource="{Binding MixerChannels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Number}"/>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}"/>
                                                <Slider Grid.Column="2" Tag="{Binding Number}" Minimum="0" Maximum="255" Value="{Binding Value, Mode=TwoWay}" ValueChanged="MixerSlider_Changed"/>
                                                <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Value}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Fixture Profile">
                <Grid Background="#111827" Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Foreground="#E2E8F0" Text="Manufacturer"/><TextBox x:Name="ManufacturerText"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Foreground="#E2E8F0" Text="Model"/><TextBox x:Name="ModelText"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Foreground="#E2E8F0" Text="Channels"/><TextBox x:Name="ChannelCountText"/></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Foreground="#E2E8F0" Text="Evidence"/><ComboBox x:Name="EvidenceCombo"/></StackPanel>
                    </Grid>
                    <DataGrid x:Name="ProfileGrid" Grid.Row="1" Margin="3" AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding ProfileChannels}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="45"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTemplateColumn Header="Role" Width="120">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Role}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.ChannelRoles, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Role}"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Blackout / safe" Binding="{Binding SafeValue}" Width="105"/>
                            <DataGridCheckBoxColumn Header="Auto" Binding="{Binding Automatable}" Width="55"/>
                            <DataGridTextColumn Header="Auto min" Binding="{Binding AutomationMin}" Width="70"/>
                            <DataGridTextColumn Header="Auto max" Binding="{Binding AutomationMax}" Width="70"/>
                            <DataGridCheckBoxColumn Header="Hazardous" Binding="{Binding Hazardous}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="2">
                        <TextBlock x:Name="ProfileStatusText" DockPanel.Dock="Left" Margin="6" VerticalAlignment="Center" Foreground="#FBBF24"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox x:Name="SimulationOnlyCheck" Content="Simulation only" VerticalAlignment="Center"/>
                            <Button Click="AddChannel_Click" Content="Add channel"/><Button Click="RemoveChannel_Click" Content="Remove selected"/>
                            <Button Click="ApplyProfile_Click" Content="Apply profile"/><Button Click="ImportProfile_Click" Content="Import JSON"/><Button Click="ExportProfile_Click" Content="Export JSON"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Artwork to ILDA">
                <Grid Background="#111827" Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Button Click="ImportArtwork_Click" Content="Import PNG / JPEG / BMP / GIF"/>
                            <CheckBox x:Name="PhotoEdgesCheck" Content="Photograph edge mode"/>
                            <GroupBox Header="Calibration">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Threshold"/><TextBox x:Name="ThresholdText" Grid.Row="0" Grid.Column="1" Text="128"/>
                                    <TextBlock Grid.Row="1" Text="Canny low"/><TextBox x:Name="EdgeLowText" Grid.Row="1" Grid.Column="1" Text="60"/>
                                    <TextBlock Grid.Row="2" Text="Canny high"/><TextBox x:Name="EdgeHighText" Grid.Row="2" Grid.Column="1" Text="150"/>
                                    <TextBlock Grid.Row="3" Text="Point budget"/><TextBox x:Name="PointBudgetText" Grid.Row="3" Grid.Column="1" Text="600"/>
                                    <TextBlock Grid.Row="4" Text="Blanking dwell"/><TextBox x:Name="BlankingDwellText" Grid.Row="4" Grid.Column="1" Text="4"/>
                                    <TextBlock Grid.Row="5" Text="Corner dwell"/><TextBox x:Name="CornerDwellText" Grid.Row="5" Grid.Column="1" Text="0"/>
                                    <TextBlock Grid.Row="6" Text="Scale"/><TextBox x:Name="ScaleText" Grid.Row="6" Grid.Column="1" Text="0.9"/>
                                </Grid>
                            </GroupBox>
                            <CheckBox x:Name="PreviewApprovedCheck" Checked="PreviewApproval_Changed" Unchecked="PreviewApproval_Changed" Content="I reviewed the ordered path preview"/>
                            <Button x:Name="ExportIldaButton" Click="ExportIlda_Click" IsEnabled="False" Content="Export standard ILDA (LM-002 unverified)"/>
                            <Button Click="InspectIlda_Click" Content="Inspect an existing ILDA file"/>
                            <TextBlock x:Name="ArtworkStatusText" Margin="5" TextWrapping="Wrap" Foreground="#FBBF24" Text="No artwork loaded."/>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Column="1" Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Background="Black" BorderBrush="#475569" BorderThickness="1"><Canvas x:Name="PreviewCanvas" Background="Black" SizeChanged="PreviewCanvas_SizeChanged"/></Border>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Frame"/><Slider x:Name="FrameSlider" Width="300" Margin="8" Minimum="0" Maximum="0" ValueChanged="FrameSlider_Changed"/><TextBlock x:Name="FrameStatusText" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Show Project">
                <Grid Background="#111827" Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <GroupBox Header="Project">
                        <StackPanel>
                            <TextBlock Text="Name"/><TextBox x:Name="ProjectNameText" Text="Untitled Show"/>
                            <Button Click="SaveProject_Click" Content="Save project JSON"/><Button Click="LoadProject_Click" Content="Load project JSON"/>
                            <TextBlock Margin="4" TextWrapping="Wrap" Foreground="#94A3B8" Text="Projects store fixture assignment, safety limits, scenes, automatic mappings, and ordered scene cues."/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="Ordered cues">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="AddCue_Click" Content="Add selected scene"/><Button Click="RemoveCue_Click" Content="Remove cue"/><Button Click="MoveCueUp_Click" Content="Move up"/><Button Click="MoveCueDown_Click" Content="Move down"/>
                            </StackPanel>
                            <ListBox x:Name="CuesList"/>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Background="#1E293B" Foreground="#E2E8F0"><StatusBarItem><TextBlock x:Name="StatusText" Text="Ready. Hardware output is unavailable."/></StatusBarItem></StatusBar>
    </Grid>
</Window>
